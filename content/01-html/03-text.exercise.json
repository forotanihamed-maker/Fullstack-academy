{
  "title": "تمرین: رزومه‌ی کوتاه",
  "desc": "یک <code>h1</code>، دو <code>h2</code> و یک لیست <code>ul</code> با حداقل سه مورد بسازید.",
  "start": "<h1>نام من</h1>\n<h2>مهارت‌ها</h2>\n<p>توضیح کوتاه</p>\n<h2>علایق</h2>\n<ul><li>HTML</li></ul>",
  "tests": [
    [
      "یک h1 وجود دارد",
      "document.querySelectorAll(\"h1\").length === 1"
    ],
    [
      "حداقل دو h2 وجود دارد",
      "document.querySelectorAll(\"h2\").length >= 2"
    ],
    [
      "لیست حداقل سه مورد دارد",
      "document.querySelectorAll(\"ul li\").length >= 3"
    ]
  ]
}