      "عرض کارت مشخص است",
      "parseFloat(getComputedStyle(document.querySelector('.card')).width) > 0"
    ],
    [
      "عنوان اندازه‌ی مشخصی دارد",
      "parseFloat(getComputedStyle(document.querySelector('.card h2')).fontSize) > 0"
    ],
    [
      "کارت فاصله‌ی داخلی دارد",
      "parseFloat(getComputedStyle(document.querySelector('.card')).paddingTop) > 0"
    ],
    [
      "پس‌زمینه‌ی کارت رنگ دارد",
